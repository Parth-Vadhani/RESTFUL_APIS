<!DOCTYPE html>
<html lang="en">

<head>
       <meta charset="UTF-8">
       <meta name="viewport" content="width=device-width, initial-scale=1.0">
       <title>Document</title>
       <link rel="stylesheet" href="/css/style.css">
</head>

<body>
       <form method="POST"  action="/posts/<%=post.id%>?_method=PATCH">
              <h1>Edit Form</h1>
              <h2>Post id : <%= post.id %>
              </h2>
              <h2>@<%= post.email %>
              </h2>
              <label for="newcon">Enter new post content :</label>
              <textarea name="newcon" id="newcon"rows="10" cols="60"><%=post.content%></textarea>
              <button type="submit">Submit</button>
       </form>

</body>

</html>